# --- Database ---
# Local dev database (docker compose up -d)
DATABASE_URL=postgres://ghosted:ghosted@localhost:5432/ghosted
# Read-only replica (optional – used for analytics)
DATABASE_URL_REPLICA=
# Test database (used by Vitest integration tests)
TEST_DATABASE_URL=postgres://ghosted:ghosted@localhost:5432/ghosted_test

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Canonical public origin. REQUIRED in production: Auth.js derives its base
# URL from this instead of trusting request Host/X-Forwarded-* headers, and
# emailed verification/reset links use it. Must be https in production.
AUTH_URL=https://ghosted.example.com
# Google OAuth (optional – the button is hidden when unset)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# LinkedIn OAuth (optional – the button is hidden when unset)
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

# --- App ---
NODE_ENV=development
# Public app origin — emailed links use this, and so do the canonical URL and the
# social card. REQUIRED (https) in production.
# Read at BUILD time (`next build` inlines it), which is why the guide says to
# copy this file, set it, and build the image yourself. The routing flags below
# are read per request instead, so they work on a running container too.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Deployment shape (self-hosting) ---
# Both default to the hosted instance's behaviour, so an upgrade that sets
# nothing changes nothing.
#
# SHOW_LANDING=false makes the login screen the starter: "/" redirects to
# /login instead of rendering the marketing page.
SHOW_LANDING=true
# ALLOW_REGISTRATION=false closes sign-ups. Closed registration needs an owner
# account, which is created at container start from GHOSTED_USER_EMAIL with a
# random password printed once in the boot log (change it in Settings).
# GHOSTED_USER_PASSWORD overrides that random password for scripted setups.
ALLOW_REGISTRATION=true
GHOSTED_USER_EMAIL=
GHOSTED_USER_NAME=

# --- Who runs this instance ---
# Leave these empty on a self-hosted copy: the footer and the legal pages then
# say "self-hosted, powered by Ghosted" instead of crediting — or blaming —
# somebody who has nothing to do with your instance. The hosted instance keeps
# its own defaults, so it needs none of this.
# OPERATOR_NAME=Your Studio
# The person or entity behind that trading name. Several jurisdictions want it
# named even when the site is signed with an alias: the imprint duty, the GDPR's
# requirement that a controller be identifiable, and consumer/trader-information
# rules. An alias alone is enough to trade under, not to answer "who is
# responsible for this service?".
# OPERATOR_LEGAL_NAME=Your Real Name
# Say so if there is deliberately no commercial-register entry (a sole trader):
# otherwise "no register entry" reads as paperwork still missing.
# OPERATOR_SOLE_TRADER=false
# OPERATOR_REGISTER=HRB 12345
# OPERATOR_VAT=DE123456789
# OPERATOR_EMAIL=you@example.com
# OPERATOR_URL=https://example.com
# Where "powered by Ghosted" points (defaults to the project repository).
# POWERED_BY_URL=https://github.com/krisztianhadi/ghosted

# --- Privacy and analytics ---
# Only the operator's own instance should be found in search results; a
# self-hosted shape is noindex by default — the code cannot know who runs the
# instance beyond the shape flags, so SHOW_LANDING=false is what makes it a
# self-hosted one. Derived from SHOW_LANDING, overridable
# either way.
# SITE_INDEXABLE=false
# Analytics is off unless both of these are set — a self-hosted copy inherits no
# tracker and reports nowhere, once the shape says this is a self-hosted
# instance (SHOW_LANDING=false).
# UMAMI_SRC=https://analytics.example.com/script.js
# UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# UMAMI_DOMAINS=ghosted.example.com
# The word after the wordmark. Empty on the hosted instance; "DIY" by default
# when SHOW_LANDING=false. Set it to "none" for no tag at all.
# BRAND_TAG=DIY

# --- Email ---
# One transport, chosen by EMAIL_TRANSPORT:
#   resend  the hosted instance's transport, and the easiest self-hosted one
#   smtp    anything that speaks SMTP (Postmark, SendGrid, Mailgun, Fastmail,
#           a local Postfix) via a single connection URL
#   log     writes the message to the log instead of sending it — the dev
#           default, and fine forever on a solo instance with registration
#           closed, since then nobody needs mail to arrive
# Unset: resend when RESEND_API_KEY is set, otherwise log.
#
# ALLOW_REGISTRATION=true in production requires a delivering transport (resend
# or smtp): verification and password reset both go through it, and without one
# sign-ups break one at a time. The app refuses to boot instead.
# EMAIL_TRANSPORT=resend
# RESEND_API_KEY=
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# `smtp://` is upgraded with STARTTLS, and refused if the server does not offer
# it — credentials never travel in the clear. Set this to 1 only for an
# unauthenticated relay on the same machine (a local Postfix).
# SMTP_ALLOW_INSECURE=
# Must be an address on a domain you control — deliverability (SPF/DKIM) is the
# operator's side of the fence.
# EMAIL_FROM="Ghosted <ghosted@example.com>"

# --- Security ---
# Rate limiting: max attempts per IP per window (minutes)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=15
# Authenticated write endpoints (create/update app, milestones, profile,
# export, account deletion): max requests per user per window (minutes).
# Generous default to allow bulk entry; tighten for stricter anti-abuse.
RATE_LIMIT_WRITES_MAX=300
RATE_LIMIT_WRITES_WINDOW_MINUTES=60
# Unverified accounts may create at most this many applications total
# (server-enforced; the UI shows a verification modal once the cap is hit).
UNVERIFIED_APP_LIMIT=3
# Password reset token lifetime (minutes)
PASSWORD_RESET_TTL_MINUTES=60
# Applications in applied|interviewing untouched this many days are shown as "ghosted"
GHOSTED_AFTER_DAYS=14

# --- Email (Resend) ---
# REQUIRED in production: without it, verification/reset emails are silently
# stubbed in dev, but the app fails loudly in production rather than pretend
# to send. Never use the shared test key (resend.dev only reaches your inbox).
RESEND_API_KEY=
# REQUIRED in production — must be a verified sender on your Resend domain.
# The default (onboarding@resend.dev) only reaches your own inbox.
EMAIL_FROM=Ghosted <onboarding@resend.dev>
# Email verification token lifetime (minutes)
EMAIL_VERIFICATION_TTL_MINUTES=1440

# Donate link (banner + user menu). Point at your coffee page.
NEXT_PUBLIC_DONATE_URL=https://www.buymeacoffee.com/lostsignals
